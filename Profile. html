<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الملف الشخصي | منصة حجز الامتحانات</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Cairo', sans-serif;
            background: #f1f5f9;
            min-height: 100vh;
            padding: 20px;
        }
        .app-container {
            max-width: 600px;
            margin: 0 auto;
        }
        .app-header {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 28px;
            padding: 16px 24px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        .header-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .header-brand .logo-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.4rem;
        }
        .header-brand h1 {
            font-size: 1.4rem;
            font-weight: 900;
            color: #1a1a2e;
        }
        .header-brand h1 span {
            color: #667eea;
        }
        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .btn-back {
            padding: 8px 18px;
            border: 2px solid #667eea;
            border-radius: 50px;
            background: transparent;
            color: #667eea;
            font-weight: 700;
            cursor: pointer;
            font-family: 'Cairo', sans-serif;
            transition: 0.3s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
        }
        .btn-back:hover {
            background: #667eea;
            color: white;
        }
        .profile-card {
            background: white;
            border-radius: 24px;
            padding: 32px 36px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        .profile-avatar-large {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
            font-weight: 700;
            margin: 0 auto 20px;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
        }
        .profile-card h2 {
            text-align: center;
            font-size: 1.4rem;
            font-weight: 800;
            color: #1a1a2e;
            margin-bottom: 4px;
        }
        .profile-card .subtitle {
            text-align: center;
            color: #94a3b8;
            font-size: 0.9rem;
            margin-bottom: 24px;
        }
        .form-group {
            margin-bottom: 18px;
        }
        .form-group label {
            display: block;
            font-weight: 700;
            font-size: 0.9rem;
            color: #334155;
            margin-bottom: 6px;
        }
        .form-group label i {
            color: #667eea;
            margin-left: 6px;
        }
        .form-group input {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 14px;
            font-size: 1rem;
            font-family: 'Cairo', sans-serif;
            background: #f8fafc;
            color: #1e293b;
            transition: 0.3s;
        }
        .form-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
            background: white;
        }
        .form-group input:disabled {
            background: #f1f5f9;
            color: #94a3b8;
        }
        .btn-save {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 14px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            font-weight: 800;
            font-size: 1.1rem;
            font-family: 'Cairo', sans-serif;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            box-shadow: 0 4px 14px rgba(102, 126, 234, 0.3);
            margin-top: 8px;
        }
        .btn-save:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.4);
        }
        .btn-save:active {
            transform: scale(0.97);
        }
        .btn-danger {
            width: 100%;
            padding: 14px;
            border: 2px solid #dc2626;
            border-radius: 14px;
            background: transparent;
            color: #dc2626;
            font-weight: 700;
            font-size: 1rem;
            font-family: 'Cairo', sans-serif;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 12px;
        }
        .btn-danger:hover {
            background: #dc2626;
            color: white;
        }
        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
            padding: 16px 24px;
            border-radius: 14px;
            background: #1e293b;
            color: white;
            font-weight: 600;
            font-size: 0.95rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 14px;
            transform: translateX(120%);
            transition: 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.2);
            max-width: 400px;
        }
        .toast.show {
            transform: translateX(0);
        }
        .toast.success {
            background: linear-gradient(135deg, #065f46, #047857);
        }
        .toast.error {
            background: linear-gradient(135deg, #991b1b, #dc2626);
        }
        .toast.warning {
            background: linear-gradient(135deg, #92400e, #d97706);
        }
        .toast i {
            font-size: 1.5rem;
        }
        @media (max-width: 768px) {
            .app-header {
                padding: 12px 16px;
            }
            .header-brand h1 {
                font-size: 1.1rem;
            }
            .profile-card {
                padding: 24px 18px;
            }
            .profile-avatar-large {
                width: 80px;
                height: 80px;
                font-size: 2.4rem;
            }
            .toast {
                right: 16px;
                left: 16px;
                max-width: none;
                bottom: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <header class="app-header">
            <div class="header-brand">
                <div class="logo-icon"><i class="fas fa-graduation-cap"></i></div>
                <h1>الملف <span>الشخصي</span></h1>
            </div>
            <div class="header-actions">
                <a href="booking.html" class="btn-back"><i class="fas fa-arrow-right"></i> العودة</a>
            </div>
        </header>

        <div class="profile-card">
            <div class="profile-avatar-large" id="profileAvatar">أ</div>
            <h2 id="displayName">أحمد محمد</h2>
            <p class="subtitle" id="displayEmail">student@example.com</p>

            <form id="profileForm">
                <div class="form-group">
                    <label><i class="fas fa-user"></i> الاسم الكامل</label>
                    <input type="text" id="fullName" placeholder="الاسم الكامل" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-id-card"></i> الصف الدراسي</label>
                    <input type="text" id="studentClass" placeholder="مثال: ٣ث / علمي" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-school"></i> المدرسة</label>
                    <input type="text" id="school" placeholder="اسم المدرسة" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-phone"></i> رقم الهاتف</label>
                    <input type="tel" id="phone" placeholder="٠١٠٠٢٢٣٣٤٤٥" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-envelope"></i> البريد الإلكتروني</label>
                    <input type="email" id="email" disabled>
                </div>

                <button type="submit" class="btn-save"><i class="fas fa-save"></i> حفظ التعديلات</button>
            </form>

            <button class="btn-danger" onclick="deleteAccount()"><i class="fas fa-trash-alt"></i> حذف الحساب</button>
        </div>
    </div>

    <div class="toast" id="toast">
        <i class="fas fa-circle-check"></i>
        <span id="toastMessage">تم حفظ التعديلات بنجاح</span>
    </div>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyB0p0us6BuzD2ngzjhRnmUIhlOcBeRp0vQ",
            authDomain: "tok-tak-d6e17.firebaseapp.com",
            databaseURL: "https://tok-tak-d6e17-default-rtdb.firebaseio.com",
            projectId: "tok-tak-d6e17",
            storageBucket: "tok-tak-d6e17.appspot.com",
            messagingSenderId: "547062578826",
            appId: "1:547062578826:web:aa285cf798341be07cb773"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const database = firebase.database();

        let currentUser = null;

        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        let toastTimeout;

        function showToast(message, type = 'success') {
            toast.className = `toast ${type}`;
            toastMessage.textContent = message;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
        }

        auth.onAuthStateChanged(user => {
            if (user) {
                currentUser = user;
                document.getElementById('displayName').textContent = user.displayName || 'طالب';
                document.getElementById('displayEmail').textContent = user.email || '';
                document.getElementById('profileAvatar').textContent = (user.displayName || 'طالب')[0];
                document.getElementById('email').value = user.email || '';
                loadUserProfile(user.uid);
            } else {
                window.location.href = 'login.html';
            }
        });

        function loadUserProfile(uid) {
            database.ref(`users/${uid}`).once('value').then(snapshot => {
                const data = snapshot.val();
                if (data) {
                    document.getElementById('fullName').value = data.name || '';
                    document.getElementById('studentClass').value = data.class || '';
                    document.getElementById('school').value = data.school || '';
                    document.getElementById('phone').value = data.phone || '';
                    document.getElementById('displayName').textContent = data.name || 'طالب';
                    document.getElementById('profileAvatar').textContent = (data.name || 'طالب')[0];
                }
            });
        }

        document.getElementById('profileForm').addEventListener('submit', function(e) {
            e.preventDefault();
            if (!currentUser) return;

            const name = document.getElementById('fullName').value.trim();
            const studentClass = document.getElementById('studentClass').value.trim();
            const school = document.getElementById('school').value.trim();
            const phone = document.getElementById('phone').value.trim();

            if (!name) {
                showToast('⚠️ الرجاء إدخال الاسم', 'error');
                return;
            }

            // Update display name in Auth
            currentUser.updateProfile({ displayName: name })
                .then(() => {
                    // Save to database
                    return database.ref(`users/${currentUser.uid}`).set({
                        name: name,
                        class: studentClass,
                        school: school,
                        phone: phone,
                        email: currentUser.email,
                        updatedAt: Date.now()
                    });
                })
                .then(() => {
                    showToast('✅ تم حفظ التعديلات بنجاح', 'success');
                    document.getElementById('displayName').textContent = name;
                    document.getElementById('profileAvatar').textContent = name[0];
                })
                .catch(err => {
                    showToast('❌ حدث خطأ في الحفظ', 'error');
                });
        });

        function deleteAccount() {
            if (!currentUser) return;
            if (confirm('⚠️ هل أنت متأكد من حذف حسابك؟ هذا الإجراء لا يمكن التراجع عنه!')) {
                if (confirm('هل أنت متأكد مرة أخرى؟')) {
                    database.ref(`users/${currentUser.uid}`).remove()
                        .then(() => {
                            return currentUser.delete();
                        })
                        .then(() => {
                            showToast('✅ تم حذف الحساب بنجاح', 'success');
                            setTimeout(() => {
                                window.location.href = 'login.html';
                            }, 1500);
                        })
                        .catch(err => {
                            showToast('❌ حدث خطأ في حذف الحساب', 'error');
                        });
                }
            }
        }
    </script>
</body>
</html>
